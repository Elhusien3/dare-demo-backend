# ─────────────────────────────────────────────────────────────
#  Project D.A.R.E. — Environment Variables
#  Copy this file to .env and fill in your real values
#  DO NOT commit .env to GitHub — it contains secrets
# ─────────────────────────────────────────────────────────────

# Twilio Credentials
# Get from: https://console.twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX

# Your deployed URL (set this after deploying to Render)
# Example: https://dare-demo.onrender.com
BASE_URL=https://YOUR-APP-NAME.onrender.com

# Port (Render sets this automatically, leave as 3000 for local)
PORT=3000
